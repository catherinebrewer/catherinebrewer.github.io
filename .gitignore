_site/

# Jekyll cache — safe to delete, regenerated automatically
.jekyll-cache/
.jekyll-metadata

# Bundler lockfile (optional to commit; committing it ensures reproducible builds)
# Gemfile.lock

# macOS cruft
.DS_Store

# Python virtualenv (for vibes/lister.py)
vibes/venv/
