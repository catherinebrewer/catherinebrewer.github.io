# Gemfile — specifies which Ruby gems this Jekyll site needs.
#
# To install: run `bundle install` in this directory.
# To serve locally: run `bundle exec jekyll serve`
# To build: run `bundle exec jekyll build`
#
# github-pages gem pins Jekyll and all plugins to the same versions
# that GitHub Pages uses, so local and deployed builds match exactly.

source "https://rubygems.org"

# Use the github-pages gem for full GitHub Pages compatibility.
# This includes Jekyll and all supported plugins.
gem "github-pages", group: :jekyll_plugins

# If you'd rather use plain Jekyll (faster installs, not tied to GH Pages):
# gem "jekyll", "~> 4.4"
